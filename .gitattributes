# Normalise line endings: LF in the repo and working tree, on every OS.
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
